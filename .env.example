# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_TELEGRAM_USER_IDS=

# MiniMax API key from https://www.minimax.io (used for the M3 model)
MINIMAX_API_KEY=

# Kagi API key from https://kagi.com/settings?p=api (paid, used for search/summarizer)
KAGI_API_KEY=

# Optional: path to the DuckDB file for purchase memory (default: scout.duckdb)
#SCOUT_DB_PATH=scout.duckdb

# Optional: second-hand platforms for site-scoped search (default shown)
#SECONDHAND_SITES=ebay.com,marktplaats.nl,vinted.com
