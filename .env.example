# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_TELEGRAM_USER_IDS=

# Optional: who sees everyone's numbers in /stat. Everyone else sees only
# their own. Defaults to the FIRST id in ALLOWED_TELEGRAM_USER_IDS, so set
# this explicitly if that list is not in the order you think it is. Every id
# here must also be in the allowlist.
#SCOUT_ADMIN_USER_IDS=

# MiniMax API key from https://www.minimax.io (used for the M3 model)
MINIMAX_API_KEY=

# Kagi API key from https://kagi.com/settings?p=api (paid, used for search/summarizer)
KAGI_API_KEY=

# Optional second search engine. Kagi and Perplexity find different small
# retailers, so with this set both are searched and the results merged.
PERPLEXITY_API_KEY=

# bol.com Marketing Catalog API (affiliate account -> Seller Dashboard >
# Account > Open API). Live catalogue search with current prices; both keys
# or neither. BOL_COUNTRY is NL or BE.
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=
BOL_COUNTRY=NL

# Path to Chrome/Chromium for the headless fallback used when a shop blocks
# plain HTTP. Auto-detected when unset; the Docker image sets it. Without a
# browser the fallback is simply off.
SCOUT_CHROME=

# Optional: path to the DuckDB file for purchase memory (default: scout.duckdb)
#SCOUT_DB_PATH=scout.duckdb

# Optional: second-hand platforms for site-scoped search (default shown)
#SECONDHAND_SITES=ebay.com,marktplaats.nl,vinted.com

# Optional: eBay Browse API (developer.ebay.com -> Application Keys, Production keyset).
# Set BOTH: App ID (Client ID) and Cert ID (Client Secret). Enables live
# eBay prices/availability instead of unverified search snippets.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
#EBAY_MARKETPLACE=EBAY_NL
